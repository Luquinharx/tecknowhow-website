# Site TecKnowHow (DNS na Hostinger: A "@" e A "www" -> 146.235.62.113). O Caddy tira o HTTPS sozinho.
www.tecknowhow.pt {
	encode zstd gzip

	# ficheiros de servidor que robos procuram: 404 de verdade
	@sensiveis path_regexp (?i)(^|/)\.(env|git|svn|hg|ds_store|htaccess|htpasswd)|\.(sql|bak|old|orig|swp|log|ini|conf|pem|key)$|/(wp-admin|wp-login\.php|xmlrpc\.php|phpmyadmin)
	handle @sensiveis {
		respond 404
	}

	# assistente virtual (Node, so na propria VM)
	handle /api/* {
		reverse_proxy 127.0.0.1:3003
	}

	# site (React): ficheiro que existe, senao o index.html (rotas do React)
	handle {
		root * /var/www/tecknowhow
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
	}
}

# endereco sem www vai sempre para o principal
tecknowhow.pt {
	redir https://www.tecknowhow.pt{uri} permanent
}
